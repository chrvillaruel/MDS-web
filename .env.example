#-----------------------------------------------------------------------
# MDS — Million Dollar Software
# All environment variables are documented here. Never commit .env.
#-----------------------------------------------------------------------

APP_NAME=MDS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH
APP_TIMEZONE=Asia/Manila

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database — use Postgres in all environments past local sqlite
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=mds
# DB_USERNAME=mds
# DB_PASSWORD=

# Session / cache / queue / broadcast
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Redis (production: Laravel Cloud managed Redis 7)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@mds.ph"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage (production: Laravel Cloud Object Storage / S3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Inertia / Vite
VITE_APP_NAME="${APP_NAME}"

#-----------------------------------------------------------------------
# Billing — Stripe + PayMongo (PH e-wallets) — wired in M6
#-----------------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=PHP
CASHIER_CURRENCY_LOCALE=en_PH

PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

#-----------------------------------------------------------------------
# Search — Scout (driver chosen in M3+; default to "database" in dev)
#-----------------------------------------------------------------------
SCOUT_DRIVER=database

#-----------------------------------------------------------------------
# Observability — Pulse, Telescope, Nightwatch
#-----------------------------------------------------------------------
PULSE_ENABLED=true
TELESCOPE_ENABLED=false
NIGHTWATCH_TOKEN=

#-----------------------------------------------------------------------
# Compliance — BIR-specific configuration (placeholders, set per seller)
#-----------------------------------------------------------------------
BIR_TIMEZONE=Asia/Manila
BIR_VAT_RATE=0.12
